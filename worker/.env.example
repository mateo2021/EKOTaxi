# Skopiuj do worker/.env (plik jest w .gitignore) i uzupełnij.
# Klucz service_role omija RLS — trzymaj go tylko lokalnie, nigdy w repozytorium.
SUPABASE_URL=https://twoj-projekt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Opcjonalnie: pełna ścieżka do claude.exe (domyślnie "claude" z PATH).
# Na Windows wskaż plik .exe, nie .cmd — worker uruchamia go bez shella.
# CLAUDE_BIN=C:\Users\TWOJ_UZYTKOWNIK\.local\bin\claude.exe
